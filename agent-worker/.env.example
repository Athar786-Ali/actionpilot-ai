# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Gemini API Keys (Multi-Key Rotation Pool) ──────────────────
# Add up to 5 keys for automatic failover on rate limits.
# Get keys at: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Webhook Configuration (Must match Backend)
WEBHOOK_URL=http://localhost:3001/api/webhooks/logs
WEBHOOK_SECRET=your-webhook-secret-key

# BullMQ Queue Name (Must match Backend)
BULLMQ_QUEUE_NAME=actionpilot_jobs

# HITL Redis Pub/Sub
REDIS_HITL_CHANNEL_PREFIX=actionpilot:hitl:

# HITL Timeout (Seconds)
HITL_TIMEOUT_SECONDS=300

# Browser Configuration
BROWSER_HEADLESS=true
