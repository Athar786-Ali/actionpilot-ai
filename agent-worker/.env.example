# ──────────────────────────────────────────────
# ActionPilot AI — Agent Worker Configuration
# ──────────────────────────────────────────────

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Node.js API Backend (Webhook Target)
WEBHOOK_URL=http://localhost:3001/api/webhooks/logs
WEBHOOK_SECRET=your-webhook-secret-key

# BullMQ
BULLMQ_QUEUE_NAME=actionpilot:jobs

# HITL Redis Pub/Sub
REDIS_HITL_CHANNEL_PREFIX=actionpilot:hitl:

# HITL Timeout (seconds) — how long to wait for human OTP
HITL_TIMEOUT_SECONDS=300

# Browser Configuration
BROWSER_HEADLESS=true
