# ──────────────────────────────────────────────
# ActionPilot AI — API Backend Configuration
# ──────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/actionpilot?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ
BULLMQ_QUEUE_NAME=actionpilot:jobs

# HITL Redis Pub/Sub
REDIS_HITL_CHANNEL_PREFIX=actionpilot:hitl:

# Webhook (self-referencing for local dev)
WEBHOOK_SECRET=your-webhook-secret-key
